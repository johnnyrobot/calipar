{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calipar-pwa-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  // Two tiers. AI_IP_LIMITER is the abuse ceiling and keys on a salted digest of
  // the connecting address; AI_RATE_LIMITER is per-session fairness underneath it;
  // AI_MINT_LIMITER bounds session minting, without which the per-session budget
  // is multiplied by however many sessions a caller cares to mint.
  // `period` accepts only 10 or 60 (node_modules/wrangler/config-schema.json).
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AI_IP_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AI_MINT_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
