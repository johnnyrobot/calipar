{
  "name": "calipar-pwa-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, installable CALIPAR demonstration workspace",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=20.9.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run pwa:build",
    "pwa:build": "serwist build",
    "preview": "wrangler dev",
    "preview:e2e": "wrangler dev --local --port 8787",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run --config vitest.config.ts --coverage",
    "test:worker": "vitest run --config vitest.worker.config.ts --coverage",
    "test:eval": "vitest run --config vitest.eval.config.ts",
    "eval:judge": "node tests/eval/judge/run.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "test:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "test:ai:live": "LIVE_AI=1 playwright test tests/e2e/live-ai.spec.ts --project=chromium-desktop",
    "verify:artifacts": "node scripts/verify/artifacts.mjs",
    "verify:headers": "node scripts/verify/headers.mjs",
    "cloudflare:limits": "node scripts/cloudflare/check-free-limits.mjs",
    "cloudflare:dry-run": "node scripts/cloudflare/dry-run.mjs",
    "cloudflare:preview": "node scripts/cloudflare/upload-preview.mjs",
    "cloudflare:promote": "node scripts/cloudflare/promote.mjs",
    "cloudflare:rollback": "node scripts/cloudflare/rollback.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:worker && npm run test:eval && npm run build && npm run verify:artifacts && npm run cloudflare:limits && npm run cloudflare:dry-run && npm run test:e2e",
    "verify:full": "npm run verify && npm run test:a11y && npm run test:lighthouse"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.5.4",
    "clsx": "2.1.1",
    "dexie": "4.4.4",
    "dompurify": "3.4.12",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "serwist": "9.5.12",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@serwist/build": "9.5.12",
    "@serwist/cli": "9.5.12",
    "@serwist/next": "9.5.12",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.4",
    "concurrently": "10.0.4",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.2"
  }
}
